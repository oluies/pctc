package build

import mill.*
import mill.scalalib.*

/** Mill build for the P-CTC simulation, kept in sync with build.sbt.
  *
  * Scotty 0.7.0, tag v0.7.0 of oluies/scotty, has to be installed first with
  * `./mill scotty.publishM2Local` (or `sbt publishM2`) in a checkout of that tag.
  *
  * Usage: `mill pctc.run`, `mill pctc.test`, `mill pctc.runMain pctc.Query`.
  */
object pctc extends ScalaModule {
  def scalaVersion = "3.9.0"

  def scalacOptions = Seq("-deprecation", "-feature", "-unchecked", "-release:21")

  def mainClass = Some("pctc.Main")

  def mvnDeps = Seq(
    mvn"io.github.oluies::scotty:0.7.0",
    mvn"org.duckdb:duckdb_jdbc:1.5.6.0"
  )

  // Picks up the locally installed Scotty from ~/.m2/repository.
  def repositories = Task {
    super.repositories() :+ s"file://${sys.props("user.home")}/.m2/repository"
  }

  def sources = Task.Sources(moduleDir / os.up / "src" / "main" / "scala")

  object test extends ScalaTests with TestModule.Munit {
    def mvnDeps = Seq(mvn"org.scalameta::munit:1.3.6")

    def sources = Task.Sources(moduleDir / os.up / os.up / "src" / "test" / "scala")

    def resources = Task.Sources(moduleDir / os.up / os.up / "src" / "test" / "resources")
  }
}
